<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login_white"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ivGreenBg"
        android:layout_width="match_parent"
        android:layout_height="671dp"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_regis" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:background="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="56dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="40dp">

                <TextView
                    android:id="@+id/tvTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lupa Password?"
                    android:textColor="#1A6B3F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tenang, kami bantu reset"
                    android:textColor="#1A6B3F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/ivStripe"
                    android:layout_width="111dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="-15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/stripe_vector"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/forgotPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="60dp"
                android:paddingEnd="28dp"
                android:paddingBottom="40dp">

                <ImageView
                    android:layout_width="272dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="Nutrisee"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_nutrisee" />

                <!-- Email -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_dialog_email"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Email terdaftar"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Password Baru -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPasswordBaru"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Password baru"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Konfirmasi Password Baru -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etKonfirmPasswordBaru"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Konfirmasi password baru"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Tombol Reset -->
                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_button_signin"
                    android:stateListAnimator="@null"
                    android:text="Reset Password"
                    android:textColor="#1A6B3F"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Kembali ke Login"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>