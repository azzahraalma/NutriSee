<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="100dp"
        android:paddingBottom="40dp">

        <!-- Judul -->

        <!-- Foto Profil -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:text="Lengkapi Profil"
            android:textColor="#1A6B3F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="60dp">

            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:src="@drawable/foto_profil_default"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_profile_circle"
                android:clipToOutline="true"
                android:contentDescription="Foto Profil" />

            <ImageView
                android:id="@+id/btnAddPhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_add_circle"
                android:contentDescription="Tambah Foto"
                android:background="@android:color/transparent" />

        </FrameLayout>

        <!-- Field Nama -->
        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama"
            android:inputType="textPersonName"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:gravity="center"
            android:background="@drawable/bg_field_underline"
            android:paddingBottom="8dp"
            android:layout_marginBottom="28dp"
            android:singleLine="true" />

        <!-- Jenis Kelamin & Tanggal Lahir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Jenis Kelamin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jenis Kelamin"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvJenisKelamin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Laki-laki"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_field_rounded"
                    android:drawableEnd="@android:drawable/arrow_down_float"
                    android:drawablePadding="8dp" />

            </LinearLayout>

            <!-- Tanggal Lahir -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal Lahir"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTanggalLahir"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="00-00-0000"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_field_rounded"
                    android:drawableEnd="@android:drawable/arrow_down_float"
                    android:drawablePadding="8dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Berat & Tinggi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berat"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etBerat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="110kg"
                    android:inputType="numberDecimal"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_field_rounded"
                    android:singleLine="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tinggi"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTinggi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="170cm"
                    android:inputType="numberDecimal"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_field_rounded"
                    android:singleLine="true" />

            </LinearLayout>
        </LinearLayout>

        <!-- Target Berat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Berat"
                android:textColor="#333333"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTargetBerat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="80kg"
                android:inputType="numberDecimal"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_field_rounded"
                android:singleLine="true" />

        </LinearLayout>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_simpan"
            android:stateListAnimator="@null"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>