<?xml version="1.0" encoding="utf-8"?>
<!--
    item_diary_aktivitas.xml
    Row untuk entry AKTIVITAS AUTO-DETECTED di RecyclerView diary.
    Menggunakan TextView untuk icon emoji supaya tidak perlu drawable tambahan.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Icon aktivitas (emoji) di dalam background bulat hijau tua -->
    <TextView
        android:id="@+id/txtAktivitasIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_activity"
        android:gravity="center"
        android:text="🚶"
        android:textSize="22sp" />

    <!-- Nama + waktu -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNamaAktivitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jalan Kaki"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clock"
                android:tint="#BDBDBD"
                android:contentDescription="waktu" />

            <TextView
                android:id="@+id/txtWaktuAktivitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="11.49"
                android:textColor="#BDBDBD"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Kalori terbakar (merah, negatif) -->
    <TextView
        android:id="@+id/txtKaloriAktivitas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-80 kcal"
        android:textColor="#E53935"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>