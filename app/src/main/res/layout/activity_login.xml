<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: Background Putih -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login_white"
        android:scaleType="fitXY" />

    <!-- Layer 2: Foto Orang -->
    <ImageView
        android:id="@+id/ivPerson"
        android:layout_width="352dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_login_person" />

    <!-- Layer 3: Arrow + Text -->
    <LinearLayout
        android:id="@+id/ivArrowText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="-10dp"
        android:gravity="center"
        android:rotation="-10">

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Masuk untuk"
            android:textColor="#1A6B3F"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:layout_width="181dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="melanjutkan perjalanan"
            android:textColor="#1A6B3F"
            android:textSize="14sp" />

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="sehatmu"
            android:textColor="#1A6B3F"
            android:textSize="14sp"
            android:textStyle="bold|italic"
            android:gravity="center" />

        <ImageView
            android:layout_width="79dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/img_arrow"
            android:layout_marginEnd="20dp"/>

    </LinearLayout>

    <!-- Layer 4: Background Hijau -->
    <ImageView
        android:id="@+id/ivGreenBg"
        android:layout_width="match_parent"
        android:layout_height="554dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_login_green_crop" />

    <!-- Layer 5: Login Panel -->
    <LinearLayout
        android:id="@+id/loginPanel"
        android:layout_width="match_parent"
        android:layout_height="567dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="158dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:contentDescription="Nutrisee"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_nutrisee" />

        <!-- Email -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_textfield"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start|center_vertical"
                android:src="@android:drawable/ic_dialog_email" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="32dp"
                android:background="@null"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAFFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Password -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_textfield"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start|center_vertical"
                android:src="@android:drawable/ic_lock_idle_lock" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="32dp"
                android:background="@null"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAFFFFFF"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Lupa Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="20dp"
            android:text="Lupa Password?"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <!-- Tombol Sign In -->
        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_button_signin"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="Masuk"
            android:textColor="#1A6B3F"
            android:textSize="24sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            android:textAllCaps="false"/>

        <!-- Link Register -->
        <TextView
            android:id="@+id/tvGoRegisterSpan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Belum Punya Akun? Daftar"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>