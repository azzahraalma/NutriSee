<?xml version="1.0" encoding="utf-8"?>
<!--
    item_diary_makanan.xml
    Row untuk entry MAKANAN di RecyclerView diary.
    Icon: fork+knife (hijau), kalori + positif
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Icon makanan -->
    <ImageView
        android:id="@+id/imgMakananIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_food"
        android:src="@drawable/ic_food"
        android:padding="10dp"
        android:contentDescription="food" />

    <!-- Nama + waktu -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNamaMakanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sushi"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clock"
                android:tint="#BDBDBD" />

            <TextView
                android:id="@+id/txtWaktuMakanan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="12.17"
                android:textColor="#BDBDBD"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Kalori + kategori -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtKaloriMakanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+340 kcal"
            android:textColor="#0D7A45"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtKategoriMakanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Makan Siang"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>