<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login_white"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ivGreenBg"
        android:layout_width="match_parent"
        android:layout_height="731dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_regis"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@null"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="56dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai perjalanan hidup"
                    android:textColor="#1A6B3F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sehat bersama NutriSee"
                    android:textColor="#1A6B3F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/ivStripe"
                    android:layout_width="111dp"
                    android:layout_height="21dp"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="-15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/stripe_vector"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/registerPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="32dp"
                android:paddingEnd="28dp"
                android:paddingBottom="40dp">

                <ImageView
                    android:layout_width="272dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="Nutrisee"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_nutrisee" />

                <!-- Nama Lengkap -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_menu_edit"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etNama"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Nama Lengkap"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Email -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_dialog_email"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Password -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Konfirmasi Password -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_textfield"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etKonfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:background="@null"
                        android:hint="Konfirmasi Password"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp" />
                </FrameLayout>

                <!-- Terms & Condition -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:button="@drawable/checkbox_round" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Setuju Dengan "
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terms &amp; Condition"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold|italic" />

                </LinearLayout>

                <!-- Tombol Sign Up -->
                <Button
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_button_signin"
                    android:letterSpacing="0"
                    android:stateListAnimator="@null"
                    android:text="Daftar"
                    android:textColor="#1A6B3F"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="@null" />

                <TextView
                    android:id="@+id/tvGoLoginSpan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Sudah Punya Akun? Masuk"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>